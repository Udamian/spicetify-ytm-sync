{
  "name": "ytm-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Spicetify custom app that keeps a Spotify playlist mirrored to YouTube Music",
  "scripts": {
    "build": "spicetify-creator",
    "build-local": "spicetify-creator --out=dist --minify",
    "watch": "spicetify-creator --watch",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "spicetify-creator": "^1.0.17",
    "typescript": "~5.9.0"
  }
}
